{
  "name": "youtube-media-player",
  "displayName": "YouTube Media Player",
  "description": "Play YouTube videos directly in VS Code - Watch tutorials and educational content while coding",
  "version": "1.0.2",
  "publisher": "Pearlismylove",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pearlismylove/vscode-ext-youtube-player"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "youtube",
    "video",
    "player",
    "tutorial",
    "education"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#FF0000",
    "theme": "dark"
  },
  "activationEvents": [
    "onView:youtube-media-player.view"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "youtube-media-player.view",
          "name": "YouTube Media Player"
        }
      ]
    },
    "commands": [
      {
        "command": "youtube-media-player.addVideo",
        "title": "YouTube Media Player: Play Video"
      },
      {
        "command": "youtube-media-player.showHistory",
        "title": "YouTube Media Player: Show History"
      }
    ],
    "configuration": {
      "title": "YouTube Media Player",
      "properties": {
        "youtubeMediaPlayer.maxHistoryItems": {
          "type": "number",
          "default": 30,
          "description": "Maximum number of videos to keep in history"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package-vsix": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "ts-loader": "^9.5.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^2.24.0"
  }
}
